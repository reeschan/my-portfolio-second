# チャット機能 (Kimi / Moonshot AI 国際版) の API キー
MOONSHOT_API_KEY=
# 任意: 使うモデルと API の URL (未設定なら kimi-k2.6 / https://api.moonshot.ai/v1)
# MOONSHOT_MODEL=kimi-k2.6
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# /now の記事を投稿する API (POST /api/now) のトークン。Authorization: Bearer <この値> で送る
# 長いランダムな値にする (例: openssl rand -hex 32)。未設定なら誰も投稿できない
NOW_POST_TOKEN=
# /now の記事の保存先 (Upstash Redis。Vercel の Marketplace から追加すると自動で入る)
# 未設定なら開発中はプロセス内のメモリに保存する (再起動で消える)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# チャットの資料 (職務経歴書・補足資料) を置く Vercel Blob (private) の資格情報
# Vercel で Blob ストアをプロジェクトにつなぐと BLOB_STORE_ID が入る (OIDC 方式。トークンは VERCEL_OIDC_TOKEN)
# 手元では vercel env pull で .env.local に入れる。ストアの接続先と Settings → Security の OIDC で Development を有効にしておく
# トークン方式の BLOB_READ_WRITE_TOKEN でもよい
# 未設定なら開発中は手元の data/*.md を読む。資料の更新は pnpm chat-docs:upload
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Slack への通知 (Incoming Webhook の URL)。/now の投稿・更新と AI チャットへの質問を、この Webhook のチャンネルへ送る
# 未設定なら通知しない。URL は秘密として扱う (知っていれば誰でもそのチャンネルに投稿できる)
# SLACK_WEBHOOK_URL=
