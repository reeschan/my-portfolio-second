# README のアーキテクチャ図 (全体像)。細部は README の Mermaid 図を正とする
# __MONO__ は単色ロゴの色。ライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 描き直し方は docs/architecture/README.md
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

visitor: 閲覧者 {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

author: "本人\n(curl)" {
  class: ext
  icon: https://cdn.simpleicons.org/curl/__MONO__
}

browser: ブラウザ {
  class: zone
  icon: https://icons.terrastruct.com/tech%2Fbrowser-2.svg

  chat: "AI チャット\n/chat" {
    class: svc
    icon: https://icons.terrastruct.com/essentials%2F111-idea.svg
  }
  ui: "各ページ\nReact 19 + Tailwind v4 + shadcn/ui" {
    class: svc
    icon: https://cdn.simpleicons.org/react
  }
  bg: "3D 背景\nReact Three Fiber" {
    class: svc
    icon: https://cdn.simpleicons.org/threedotjs/__MONO__
  }
}

# ノードの宣言の順は ELK の配置に影響しない (並びは ELK が決める)。dagre も試したが曲線が絡んで読みにくかった
vercel: "Vercel (Next.js App Router)" {
  class: zone
  icon: https://cdn.simpleicons.org/vercel/__MONO__

  rsc: "Server Components\ndata/*.ts と /now を描画" {
    class: svc
    icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
  }
  nowapi: "/api/now\nBearer 認証" {
    class: svc
    icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
  }
  chatapi: "/api/chat\n検証・レート制限・伏せ字" {
    class: svc
    icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
  }
  docs: "resume.md\n(サーバーのみ)" {
    shape: page
  }

  chatapi -> docs: プロンプトに使う
}

saas: 外部サービス {
  class: saas
  direction: down

  redis: "Upstash Redis\n/now の記事" {
    class: ext
    icon: https://cdn.simpleicons.org/upstash
  }
  slack: "Slack\nIncoming Webhook" {
    class: ext
    icon: https://icons.terrastruct.com/dev%2Fslack.svg
  }
  llm: "Moonshot API\n(Kimi)" {
    class: ext
    icon: https://cdn.simpleicons.org/moonshotai/__MONO__
  }
}

visitor -> browser.ui
browser.chat -> vercel.chatapi: 会話履歴
browser.ui -> vercel.rsc
author -> vercel.nowapi: 投稿・更新
vercel.chatapi <-> saas.llm: ストリーム
vercel.chatapi -> saas.slack: 質問を通知 {style.stroke-dash: 4}
vercel.nowapi -> saas.slack: 投稿を通知 {style.stroke-dash: 4}
vercel.nowapi -> saas.redis: 保存
vercel.rsc -> saas.redis: 記事を読む
